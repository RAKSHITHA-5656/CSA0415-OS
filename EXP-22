#include <stdio.h>
int main() {
    int n, i, time = 0, complete = 0;
    int at[10], bt[10], rt[10], wt[10], tat[10];
    int min, shortest = -1;
    float awt = 0, atat = 0;
    scanf("%d", &n);

    for(i = 0; i < n; i++) {
        scanf("%d%d", &at[i], &bt[i]);
        rt[i] = bt[i];
    }

    while(complete < n) {
        min = 9999;
        shortest = -1;

        for(i = 0; i < n; i++) {
            if(at[i] <= time && rt[i] > 0 && rt[i] < min) {
                min = rt[i];
                shortest = i;
            }
        }

        if(shortest == -1) {
            time++;
            continue;
        }

        rt[shortest]--;
        time++;

        if(rt[shortest] == 0) {
            complete++;
            tat[shortest] = time - at[shortest];
            wt[shortest] = tat[shortest] - bt[shortest];
        }
    }

    printf("\nP\tAT\tBT\tWT\tTAT\n");

    for(i = 0; i < n; i++) {
        printf("P%d\t%d\t%d\t%d\t%d\n",
        i+1, at[i], bt[i], wt[i], tat[i]);

        awt += wt[i];
        atat += tat[i];
    }

    printf("\nAverage WT: %.2f", awt/n);
    printf("\nAverage TAT: %.2f", atat/n);

    return 0;
}
