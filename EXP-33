
#include <stdio.h>

int main()
{
    int n, f, a[30], page[10];
    int i, j, k, faults = 0, found, pos, far, next;

    printf("Enter number of pages: ");
    scanf("%d", &n);

    printf("Enter reference string: ");
    for(i = 0; i < n; i++)
        scanf("%d", &a[i]);

    printf("Enter number of frames: ");
    scanf("%d", &f);

    for(i = 0; i < f; i++)
        page[i] = -1;

    for(i = 0; i < n; i++)
    {
        found = 0;

        for(j = 0; j < f; j++)
            if(page[j] == a[i])
                found = 1;

        if(!found)
        {
            pos = -1;
            far = -1;

            for(j = 0; j < f; j++)
            {
                if(page[j] == -1)
                {
                    pos = j;
                    break;
                }

                next = n;

                for(k = i + 1; k < n; k++)
                {
                    if(a[k] == page[j])
                    {
                        next = k;
                        break;
                    }
                }

                if(next > far)
                {
                    far = next;
                    pos = j;
                }
            }

            page[pos] = a[i];
            faults++;
        }

        for(j = 0; j < f; j++)
            printf("%d ", page[j]);

        printf("\n");
    }

    printf("Total Page Faults = %d", faults);

    return 0;
}
