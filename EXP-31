
#include <stdio.h>

int main()
{
    int n, f, a[30], page[10];
    int i, j, k = 0, faults = 0, found;

    printf("Enter number of pages: ");
    scanf("%d", &n);

    printf("Enter reference string: ");
    for(i = 0; i < n; i++)
        scanf("%d", &a[i]);

    printf("Enter number of frames: ");
    scanf("%d", &f);

    for(i = 0; i < f; i++)
        page[i] = -1;

    for(i = 0; i < n; i++)
    {
        found = 0;

        for(j = 0; j < f; j++)
        {
            if(page[j] == a[i])
                found = 1;
        }

        if(!found)
        {
            page[k] = a[i];
            k = (k + 1) % f;
            faults++;
        }

        printf("\n");

        for(j = 0; j < f; j++)
            printf("%d ", page[j]);
    }

    printf("\nTotal Page Faults = %d", faults);

    return 0;
}
