
#include <stdio.h>

int main()
{
    FILE *fp;
    char name[50], data[100];
    int choice;

    printf("1.Create\n2.Write\n3.Read\n4.Append\n5.Delete\n");
    printf("Enter choice: ");
    scanf("%d", &choice);

    printf("Enter filename: ");
    scanf("%49s", name);

    switch(choice)
    {
        case 1:
            fp = fopen(name, "w");
            printf("File created successfully");
            fclose(fp);
            break;

        case 2:
            fp = fopen(name, "w");
            printf("Enter data: ");
            scanf(" %99[^\n]", data);
            fprintf(fp, "%s", data);
            fclose(fp);
            printf("Data written successfully");
            break;

        case 3:
            fp = fopen(name, "r");
            if(fp == NULL)
            {
                printf("File not found");
                break;
            }
            while(fgets(data, sizeof(data), fp))
                printf("%s", data);
            fclose(fp);
            break;

        case 4:
            fp = fopen(name, "a");
            if(fp == NULL)
            {
                printf("Cannot open file");
                break;
            }
            printf("Enter data: ");
            scanf(" %99[^\n]", data);
            fprintf(fp, "%s\n", data);
            fclose(fp);
            printf("Data appended successfully");
            break;

        case 5:
            if(remove(name) == 0)
                printf("File deleted successfully");
            else
                printf("File not found");
            break;

        default:
            printf("Invalid choice");
    }

    return 0;
}
