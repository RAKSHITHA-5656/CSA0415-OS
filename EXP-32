
#include <stdio.h>

int main()
{
    int n, f, a[30], page[10], time[10];
    int i, j, t = 0, faults = 0, found, pos;

    printf("Enter number of pages: ");
    scanf("%d", &n);

    printf("Enter reference string: ");
    for(i = 0; i < n; i++)
        scanf("%d", &a[i]);

    printf("Enter number of frames: ");
    scanf("%d", &f);

    for(i = 0; i < f; i++)
    {
        page[i] = -1;
        time[i] = 0;
    }

    for(i = 0; i < n; i++)
    {
        found = 0;

        for(j = 0; j < f; j++)
        {
            if(page[j] == a[i])
            {
                found = 1;
                time[j] = ++t;
                break;
            }
        }

        if(!found)
        {
            pos = 0;

            for(j = 0; j < f; j++)
            {
                if(page[j] == -1)
                {
                    pos = j;
                    break;
                }

                if(time[j] < time[pos])
                    pos = j;
            }

            page[pos] = a[i];
            time[pos] = ++t;
            faults++;
        }

        for(j = 0; j < f; j++)
            printf("%d ", page[j]);

        printf("\n");
    }

    printf("Total Page Faults = %d", faults);

    return 0;
}
