#include <stdio.h>
int main() {
    int n, i, time = 0, complete = 0;
    int at[10], bt[10], rt[10], pr[10];
    int wt[10], tat[10], p;
    float awt = 0, atat = 0;
    scanf("%d", &n);
    for(i = 0; i < n; i++) {
        scanf("%d%d%d", &at[i], &bt[i], &pr[i]);
        rt[i] = bt[i];
    }
    while(complete < n) {
        p = -1;
        for(i = 0; i < n; i++) {
            if(at[i] <= time && rt[i] > 0) {
                if(p == -1 || pr[i] < pr[p])
                    p = i;
            }
        }
        if(p == -1) {
            time++;
            continue;
        }
        rt[p]--;
        time++;
        if(rt[p] == 0) {
            complete++;
            tat[p] = time - at[p];
            wt[p] = tat[p] - bt[p];
        }
    }
    printf("\nP\tAT\tBT\tPR\tWT\tTAT\n");

    for(i = 0; i < n; i++) {
        printf("P%d\t%d\t%d\t%d\t%d\t%d\n",
        i+1, at[i], bt[i], pr[i], wt[i], tat[i]);

        awt += wt[i];
        atat += tat[i];
    }
    printf("\nAverage WT: %.2f", awt/n);
    printf("\nAverage TAT: %.2f", atat/n);
    return 0;
}
