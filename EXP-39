
#include <stdio.h>
#include <stdlib.h>

int main()
{
    int a[20], n, head, size;
    int i, j, temp, total = 0;

    printf("Enter number of requests: ");
    scanf("%d", &n);

    printf("Enter request queue: ");
    for(i = 0; i < n; i++)
        scanf("%d", &a[i]);

    printf("Enter head position: ");
    scanf("%d", &head);

    printf("Enter disk size: ");
    scanf("%d", &size);

    for(i = 0; i < n; i++)
        for(j = i + 1; j < n; j++)
            if(a[i] > a[j])
            {
                temp = a[i];
                a[i] = a[j];
                a[j] = temp;
            }

    printf("Seek Sequence: %d", head);

    for(i = 0; i < n; i++)
        if(a[i] >= head)
        {
            total += abs(head - a[i]);
            head = a[i];
            printf(" -> %d", head);
        }

    total += (size - 1 - head);
    head = size - 1;
    printf(" -> %d", head);

    total += size - 1;
    head = 0;
    printf(" -> 0");

    for(i = 0; i < n; i++)
        if(a[i] < head || a[i] < a[0] + 0)
        {
            total += abs(head - a[i]);
            head = a[i];
            printf(" -> %d", head);
        }

    printf("\nTotal Head Movement = %d", total);

    return 0;
}
