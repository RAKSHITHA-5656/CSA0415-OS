
#include <stdio.h>
#include <string.h>

int main()
{
    FILE *fp;
    char filename[50], word[50], line[200];

    printf("Enter filename: ");
    scanf("%49s", filename);

    printf("Enter word to search: ");
    scanf("%49s", word);

    fp = fopen(filename, "r");

    if(fp == NULL)
    {
        printf("File not found");
        return 1;
    }

    while(fgets(line, sizeof(line), fp))
    {
        if(strstr(line, word) != NULL)
            printf("%s", line);
    }

    fclose(fp);

    return 0;
}
